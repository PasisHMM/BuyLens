{
  "components": {
    "schemas": {
      "Basis": {
        "description": "What a number measures: a person's body, or a garment laid flat.",
        "enum": [
          "body",
          "garment"
        ],
        "title": "Basis",
        "type": "string"
      },
      "Brand": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "title": "Brand",
        "type": "object"
      },
      "Catalog": {
        "description": "What can be measured and which rules apply. Web forms read this and keep no copy of their own.",
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategoryOut"
            },
            "title": "Categories",
            "type": "array"
          },
          "dimensions": {
            "items": {
              "$ref": "#/components/schemas/DimensionOut"
            },
            "title": "Dimensions",
            "type": "array"
          },
          "product_types": {
            "items": {
              "$ref": "#/components/schemas/ProductTypeOut"
            },
            "title": "Product Types",
            "type": "array"
          },
          "quick_sizes": {
            "items": {
              "$ref": "#/components/schemas/QuickSize"
            },
            "title": "Quick Sizes",
            "type": "array"
          },
          "size_systems": {
            "items": {
              "$ref": "#/components/schemas/SizeSystem"
            },
            "title": "Size Systems",
            "type": "array"
          }
        },
        "required": [
          "dimensions",
          "categories",
          "product_types",
          "quick_sizes",
          "size_systems"
        ],
        "title": "Catalog",
        "type": "object"
      },
      "CategoryOut": {
        "properties": {
          "critical": {
            "items": {
              "$ref": "#/components/schemas/Dimension"
            },
            "title": "Critical",
            "type": "array"
          },
          "id": {
            "$ref": "#/components/schemas/FitCategory"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "secondary": {
            "items": {
              "$ref": "#/components/schemas/Dimension"
            },
            "title": "Secondary",
            "type": "array"
          }
        },
        "required": [
          "id",
          "label",
          "critical",
          "secondary"
        ],
        "title": "CategoryOut",
        "type": "object"
      },
      "CheckCreated": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "CheckCreated",
        "type": "object"
      },
      "CheckIn": {
        "properties": {
          "url": {
            "maxLength": 2048,
            "minLength": 4,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "CheckIn",
        "type": "object"
      },
      "CheckResult": {
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current_step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Step"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "fit_mode_used": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FitMode"
              },
              {
                "type": "null"
              }
            ]
          },
          "hidden_mismatches": {
            "$ref": "#/components/schemas/HiddenMismatches"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "input_url": {
            "title": "Input Url",
            "type": "string"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/OptionOut"
            },
            "title": "Matches",
            "type": "array"
          },
          "product": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProductOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "selected_size": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Size"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "uncertain": {
            "items": {
              "$ref": "#/components/schemas/OptionOut"
            },
            "title": "Uncertain",
            "type": "array"
          },
          "unit": {
            "enum": [
              "in",
              "cm"
            ],
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "current_step",
          "input_url",
          "created_at",
          "completed_at",
          "error",
          "unit",
          "product",
          "selected_size",
          "fit_mode_used",
          "matches",
          "uncertain",
          "hidden_mismatches"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "CheckSummary": {
        "description": "The \"A recent check\" card.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "fit_outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FitOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "product_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Name"
          },
          "selected_size": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Size"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "total_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cents"
          }
        },
        "required": [
          "id",
          "status",
          "created_at",
          "product_name",
          "image_url",
          "fit_outcome",
          "selected_size",
          "total_cents",
          "currency"
        ],
        "title": "CheckSummary",
        "type": "object"
      },
      "Dimension": {
        "description": "A body measurement. Chest and bust are one measurement: the fullest girth of the upper body.",
        "enum": [
          "chest",
          "waist",
          "hips",
          "shoulders",
          "inseam",
          "sleeve",
          "height"
        ],
        "title": "Dimension",
        "type": "string"
      },
      "DimensionOut": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Dimension"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "max_cm": {
            "title": "Max Cm",
            "type": "number"
          },
          "min_cm": {
            "title": "Min Cm",
            "type": "number"
          }
        },
        "required": [
          "id",
          "label",
          "min_cm",
          "max_cm"
        ],
        "title": "DimensionOut",
        "type": "object"
      },
      "DimensionStatus": {
        "enum": [
          "inside",
          "near",
          "outside",
          "missing"
        ],
        "title": "DimensionStatus",
        "type": "string"
      },
      "FitCategory": {
        "description": "Garment groups that have agreed fit rules.",
        "enum": [
          "bottoms",
          "tops",
          "dresses",
          "outerwear"
        ],
        "title": "FitCategory",
        "type": "string"
      },
      "FitCheck": {
        "properties": {
          "approximate": {
            "default": false,
            "title": "Approximate",
            "type": "boolean"
          },
          "mode": {
            "$ref": "#/components/schemas/FitMode",
            "default": "personal_fit"
          },
          "outcome": {
            "$ref": "#/components/schemas/FitOutcome",
            "default": "uncertain"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/FitRow"
            },
            "title": "Rows",
            "type": "array"
          },
          "size_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Label"
          }
        },
        "title": "FitCheck",
        "type": "object"
      },
      "FitMode": {
        "description": "How a profile describes the user. Quick Fit sizes are approximate; Personal Fit values are exact.",
        "enum": [
          "quick_fit",
          "personal_fit"
        ],
        "title": "FitMode",
        "type": "string"
      },
      "FitOutcome": {
        "description": "Result of comparing a profile with one listing's size data.",
        "enum": [
          "match",
          "uncertain",
          "mismatch"
        ],
        "title": "FitOutcome",
        "type": "string"
      },
      "FitRow": {
        "properties": {
          "basis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Basis"
              },
              {
                "type": "null"
              }
            ]
          },
          "chart_max_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chart Max Cm"
          },
          "chart_min_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chart Min Cm"
          },
          "dimension": {
            "title": "Dimension",
            "type": "string"
          },
          "role": {
            "default": "critical",
            "enum": [
              "critical",
              "secondary"
            ],
            "title": "Role",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DimensionStatus",
            "default": "missing"
          },
          "user_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Cm"
          }
        },
        "required": [
          "dimension"
        ],
        "title": "FitRow",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HiddenMismatches": {
        "description": "Options left out of the visible results because a critical measurement doesn't fit.",
        "properties": {
          "count": {
            "default": 0,
            "title": "Count",
            "type": "integer"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          }
        },
        "title": "HiddenMismatches",
        "type": "object"
      },
      "MeasurementIn": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "$ref": "#/components/schemas/Basis",
            "default": "body"
          },
          "dimension": {
            "$ref": "#/components/schemas/Dimension"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "value": {
            "exclusiveMinimum": 0.0,
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "dimension",
          "value"
        ],
        "title": "MeasurementIn",
        "type": "object"
      },
      "MeasurementOut": {
        "properties": {
          "basis": {
            "$ref": "#/components/schemas/Basis"
          },
          "dimension": {
            "$ref": "#/components/schemas/Dimension"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "dimension",
          "value",
          "basis",
          "note"
        ],
        "title": "MeasurementOut",
        "type": "object"
      },
      "OptionOut": {
        "properties": {
          "fit_check": {
            "$ref": "#/components/schemas/FitCheck"
          },
          "listing_id": {
            "format": "uuid",
            "title": "Listing Id",
            "type": "string"
          },
          "price_check": {
            "$ref": "#/components/schemas/PriceCheck"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "seller": {
            "$ref": "#/components/schemas/SellerOut"
          },
          "seller_risk": {
            "$ref": "#/components/schemas/SellerRisk"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "total_cents": {
            "title": "Total Cents",
            "type": "integer"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "rank",
          "listing_id",
          "seller",
          "url",
          "total_cents",
          "summary",
          "price_check",
          "fit_check",
          "seller_risk"
        ],
        "title": "OptionOut",
        "type": "object"
      },
      "PriceCheck": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "listing_cents": {
            "title": "Listing Cents",
            "type": "integer"
          },
          "shipping_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shipping Cents"
          },
          "total_cents": {
            "title": "Total Cents",
            "type": "integer"
          },
          "total_is_estimate": {
            "title": "Total Is Estimate",
            "type": "boolean"
          }
        },
        "required": [
          "currency",
          "listing_cents",
          "shipping_cents",
          "total_cents",
          "total_is_estimate"
        ],
        "title": "PriceCheck",
        "type": "object"
      },
      "ProductOut": {
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "title": "Attributes",
            "type": "object"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "brand",
          "category",
          "attributes",
          "image_url"
        ],
        "title": "ProductOut",
        "type": "object"
      },
      "ProductType": {
        "enum": [
          "jeans",
          "pants",
          "sweaters",
          "tops",
          "hoodies",
          "skirts",
          "shorts",
          "hats"
        ],
        "title": "ProductType",
        "type": "string"
      },
      "ProductTypeOut": {
        "properties": {
          "fit_category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FitCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "$ref": "#/components/schemas/ProductType"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "fit_category"
        ],
        "title": "ProductTypeOut",
        "type": "object"
      },
      "ProfileIn": {
        "additionalProperties": false,
        "description": "Body of PUT /v1/profile, in the unit the user chose on the IN / cm toggle.\n\nTwo shapes are accepted. The current one names a `fit_mode` plus the sections to replace; a section\nleft out keeps what is stored. The older `{unit, waist, inseam, hips}` still means Personal Fit\nwith body measurements, for clients that haven't updated.",
        "properties": {
          "brand_ids": {
            "anyOf": [
              {
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "maxItems": 30,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand Ids"
          },
          "fit_mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FitMode"
              },
              {
                "type": "null"
              }
            ]
          },
          "hips": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hips"
          },
          "inseam": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inseam"
          },
          "measurements": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/MeasurementIn"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurements"
          },
          "quick_sizes": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/QuickSize"
                },
                "propertyNames": {
                  "$ref": "#/components/schemas/FitCategory"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quick Sizes"
          },
          "size_system": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SizeSystem"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Unit"
              },
              {
                "type": "null"
              }
            ]
          },
          "waist": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waist"
          }
        },
        "title": "ProfileIn",
        "type": "object"
      },
      "ProfileOut": {
        "description": "Measurements are returned in the user's chosen unit, ready for display.",
        "properties": {
          "brands": {
            "items": {
              "$ref": "#/components/schemas/Brand"
            },
            "title": "Brands",
            "type": "array"
          },
          "fit_mode": {
            "$ref": "#/components/schemas/FitMode"
          },
          "hips": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hips"
          },
          "inseam": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inseam"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/MeasurementOut"
            },
            "title": "Measurements",
            "type": "array"
          },
          "quick_sizes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/QuickSize"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/FitCategory"
            },
            "title": "Quick Sizes",
            "type": "object"
          },
          "size_system": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SizeSystem"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "waist": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waist"
          }
        },
        "required": [
          "unit",
          "fit_mode",
          "size_system",
          "quick_sizes",
          "measurements",
          "waist",
          "inseam",
          "hips",
          "brands",
          "updated_at"
        ],
        "title": "ProfileOut",
        "type": "object"
      },
      "QuickSize": {
        "enum": [
          "XS",
          "S",
          "M",
          "L",
          "XL"
        ],
        "title": "QuickSize",
        "type": "string"
      },
      "ReturnPolicy": {
        "properties": {
          "details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
