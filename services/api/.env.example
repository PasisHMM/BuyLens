# Copy to .env and fill in. Never commit .env.

ENV=dev
LOG_LEVEL=INFO

# Supabase → Project Settings → Database → Connection string.
# Use the direct connection or the *session* pooler (port 5432), not the transaction pooler (6543).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase → Project Settings → API → Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Leave empty for projects using JWT signing keys (verified via JWKS; recommended).
# Set only if the project still uses the legacy shared JWT secret (HS256).
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000"]

# ── Phase 2: analyzer engine ──────────────────────────────────────────
# Redis for the job queue and progress streams (Upstash: use the rediss:// URL).
REDIS_URL=redis://localhost:6379/0

# LLM provider: gemini (default) or anthropic.
LLM_PROVIDER=gemini
# Use a billing-enabled key before real users: on the free tier Google may use prompts to
# improve its products. Model IDs change often; copy the current ones from Google AI Studio.
GEMINI_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_SMART_MODEL=
# Only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Identify the bot honestly, with a way to contact you.
FETCH_USER_AGENT="BuyLensBot/0.2 (+mailto:you@example.com)"
